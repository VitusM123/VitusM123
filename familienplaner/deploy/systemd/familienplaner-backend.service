[Unit]
Description=Familienplaner Backend
After=network-online.target
Wants=network-online.target

[Service]
User=familienplaner
WorkingDirectory=/opt/familienplaner/backend
Environment=FP_CONFIG_FILE=/etc/familienplaner/config.yaml
ExecStart=/opt/familienplaner/backend/.venv/bin/uvicorn --factory app.main:app_factory --host 0.0.0.0 --port 8000
Environment=FP_SERVER__FRONTEND_DIST=/opt/familienplaner/frontend/dist
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
